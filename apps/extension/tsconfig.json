{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "node", "chrome"],
    "paths": {
      "@/prefs": ["./src/popup/prefs.ts"],
      "@/*": ["../desktop/src/*"],
      "@ext/*": ["./src/*"],
      // The bundles dedupe these to this package's copies (scripts/build.ts); type-check
      // against the same ones, so the store source zip builds without apps/desktop/node_modules.
      "vue": ["./node_modules/vue"],
      "lucide-vue-next": ["./node_modules/lucide-vue-next"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "scripts/**/*.ts", "test/**/*.ts", "*.config.ts", "../desktop/src/env.d.ts"]
}
