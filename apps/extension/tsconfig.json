{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "node", "chrome"],
    "paths": {
      "@/prefs": ["./src/popup/prefs.ts"],
      "@/*": ["../desktop/src/*"],
      "@ext/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "scripts/**/*.ts", "test/**/*.ts", "*.config.ts", "../desktop/src/env.d.ts"]
}
