{
  "name": "qasa-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun",
  "scripts": {
    "dev": "bun scripts/build.ts --watch",
    "build": "vue-tsc --noEmit -p tsconfig.json && bun scripts/build.ts",
    "build:store": "vue-tsc --noEmit -p tsconfig.json && bun scripts/build.ts --store",
    "package": "bun scripts/package.ts",
    "test": "vitest run",
    "e2e": "bun run build && playwright test",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "lint:store": "web-ext lint --source-dir release/unpacked/firefox",
    "vectors": "bun scripts/make-vectors.ts",
    "e2e:real": "bun run build && playwright test -c playwright.real.config.ts",
    "e2e:firefox": "bun run build && bun test/firefox/firefox-e2e.ts"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^15.11.7",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0",
    "web-ext": "8.3.0"
  }
}
