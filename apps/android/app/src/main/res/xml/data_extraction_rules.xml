<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+. Backups are off (android:allowBackup="false"), but a device-to-device transfer
   still reads these rules: the website icon cache (files/site-icons, docs/site-icons.md) is
   sealed with the vault key and stays on this device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="site-icons/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="site-icons/" />
    </device-transfer>
</data-extraction-rules>
