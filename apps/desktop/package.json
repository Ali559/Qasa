{
  "name": "qasa-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "tauri": "tauri",
    "tokens": "python3 scripts/tokens.py",
    "icons": "python3 scripts/app-icon.py && tauri icon src-tauri/icons/app-icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "tokens:check": "python3 scripts/tokens.py --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
