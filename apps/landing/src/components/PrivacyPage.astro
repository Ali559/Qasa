---
// The privacy policy and terms of use pages (/privacy, /terms and their /ckb, /ar versions).
// Standalone like the download page, so they work while the home page is still the
// coming-soon page; the store listings and the apps' Privacy and Terms rows point here.
// The text is in src/privacy.ts and src/terms.ts.
import "../styles/global.css";
import Icon from "./Icon.astro";
import { dictionaries, downloadHrefs, languages, privacyHrefs, termsHrefs, type Lang } from "../i18n";
import { policies, PRIVACY_UPDATED } from "../privacy";
import { termsByLang, TERMS_UPDATED } from "../terms";

const { lang, kind = "privacy" } = Astro.props as { lang: Lang; kind?: "privacy" | "terms" };
const t = dictionaries[lang];
const p = kind === "terms" ? termsByLang[lang] : policies[lang];
const hrefs = kind === "terms" ? termsHrefs : privacyHrefs;
const updatedIso = kind === "terms" ? TERMS_UPDATED : PRIVACY_UPDATED;
const dir = lang === "en" ? "ltr" : "rtl";
const home = languages.find((l) => l.lang === lang)!.href;
const short = p.sections.find((s) => s.id === "short")!;
const rest = p.sections.filter((s) => s.id !== "short");
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{p.pageTitle}</title>
    <meta name="description" content={p.pageDescription} />
    <meta name="theme-color" content="#FBF6F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1D1F" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={p.pageTitle} />
    <meta property="og:description" content={p.pageDescription} />
    <meta property="og:locale" content={{ en: "en_US", ckb: "ckb_IQ", ar: "ar_IQ" }[lang]} />
    {languages.map((l) => <link rel="alternate" hreflang={l.lang} href={hrefs[l.lang]} />)}
    <link rel="alternate" hreflang="x-default" href={hrefs.en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/IBMPlexSansArabic-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href={home} class="brand" lang="en" aria-label="Qasa">
          <img class="brand-mark" src="/favicon.svg" alt="" width="34" height="34" />
          Qasa
        </a>
        <nav class="lang-switch" aria-label={t.nav.language}>
          {languages.map((l) => (
            <a href={hrefs[l.lang]} lang={l.lang} hreflang={l.lang} aria-current={l.lang === lang ? "page" : undefined}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div class="bg" aria-hidden="true"></div>
      <article class="wrap policy">
        <header class="policy-head">
          <p class="kicker">{p.kicker}</p>
          <h1 class="title">{p.title}</h1>
          <p class="updated"><time datetime={updatedIso}>{p.updated}</time></p>
        </header>

        <section class="short" aria-labelledby="short">
          <h2 id="short"><Icon name="shield-check" size={20} /> <span>{short.title}</span></h2>
          {short.body.map((b) =>
            Array.isArray(b)
              ? <ul>{b.map((item) => <li set:html={item} />)}</ul>
              : <p set:html={b} />
          )}
        </section>

        <nav class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title">{p.contents}</h2>
          <ol>
            {rest.map((s) => <li><a href={`#${s.id}`} set:html={s.title} /></li>)}
          </ol>
        </nav>

        {rest.map((s) => (
          <section class="part" aria-labelledby={s.id}>
            <h2 id={s.id} set:html={s.title} />
            {s.body.map((b) =>
              Array.isArray(b)
                ? <ul>{b.map((item) => <li set:html={item} />)}</ul>
                : <p set:html={b} />
            )}
          </section>
        ))}
      </article>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <a href={home} class="brand small" lang="en"><img class="brand-mark" src="/favicon.svg" alt="" width="34" height="34" />Qasa</a>
        <nav class="footer-links" aria-label="Footer">
          <a href={home}><Icon name="device-mobile" size={16} /> {t.desktop.phones}</a>
          <a href={downloadHrefs[lang]}><Icon name="device-desktop" size={16} /> {t.desktop.kicker}</a>
          <a href={kind === "terms" ? privacyHrefs[lang] : termsHrefs[lang]}>{kind === "terms" ? t.nav.privacy : t.nav.terms}</a>
        </nav>
        <p>© {new Date().getFullYear()} <span lang="en">Qasa</span></p>
      </div>
    </footer>
  </body>
</html>

<style>
  body { min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; position: relative; }
  .bg { position: absolute; inset: 0 0 auto; height: 420px; pointer-events: none; background: linear-gradient(180deg, var(--card-muted) 0%, var(--background) 100%); }

  .nav { border-bottom: 1px solid color-mix(in srgb, var(--stroke) 70%, transparent); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
  /* The logo lockup is artwork: same order and font in every language. */
  .brand { direction: ltr; display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 21px; color: var(--accent); letter-spacing: -0.01em; }
  .brand-mark { width: 34px; height: 34px; display: block; flex: none; }
  .brand.small { font-size: 16px; gap: 8px; }
  .brand.small .brand-mark { width: 26px; height: 26px; }

  .lang-switch {
    display: flex; gap: 2px; padding: 3px; border-radius: 12px;
    background: var(--card); border: 1px solid var(--stroke); font-size: 13px; font-weight: 500;
  }
  .lang-switch a { padding: 5px 10px; border-radius: 9px; color: var(--text-2); line-height: 1.4; }
  .lang-switch a:hover { color: var(--text); }
  .lang-switch a[aria-current="page"] { background: var(--card-muted); color: var(--on-accent-chip); }

  /* A reading column: the policy is long text, not a marketing layout. */
  .policy { position: relative; max-width: calc(760px + 2 * var(--gutter)); padding-block: clamp(40px, 7vw, 80px) clamp(64px, 9vw, 112px); }
  .policy-head .title { font-size: clamp(30px, 4.4vw, 44px); }
  .updated { margin-top: 16px; font-size: 14px; color: var(--text-2); }

  .policy h2 { font-size: 22px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .policy p, .policy li { font-size: 16px; line-height: 1.7; color: var(--text-2); }
  .policy p { margin-top: 12px; }
  .policy ul { margin: 12px 0 0; padding-inline-start: 22px; }
  .policy li + li { margin-top: 8px; }
  .policy li::marker { color: var(--accent); }
  .policy :global(strong) { color: var(--text); font-weight: 600; }
  .policy :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .policy :global(a:hover) { color: var(--accent-dark); }

  .short {
    margin-top: 36px; padding: 28px; border-radius: var(--radius-lg);
    background: var(--card); border: 1px solid var(--stroke); box-shadow: var(--shadow-soft);
  }
  .short h2 { display: flex; align-items: center; gap: 10px; }
  .short h2 :global(.icon) { color: var(--accent); }
  .short li { color: var(--text); }

  .toc { margin-top: 28px; padding: 22px 28px; border-radius: var(--radius-lg); background: var(--card-muted); }
  .toc h2 { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-accent-chip); }
  .toc ol { margin: 12px 0 0; padding: 0; list-style: none; columns: 2; column-gap: 28px; }
  .toc li { break-inside: avoid; padding-block: 3px; font-size: 15px; line-height: 1.5; }
  .policy .toc :global(a) { color: var(--text); text-decoration: none; }
  .policy .toc :global(a:hover) { color: var(--accent); text-decoration: underline; }

  .part { margin-top: 44px; scroll-margin-top: 24px; }
  .part h2 { scroll-margin-top: 24px; }

  /* Kurdish and Arabic: taller script needs looser leading. */
  [dir="rtl"] .policy .title { line-height: 1.4; }
  [dir="rtl"] .policy p, [dir="rtl"] .policy li { line-height: 1.9; }
  [dir="rtl"] .policy h2 { line-height: 1.5; }

  @media (max-width: 640px) {
    .short { padding: 22px; }
    .toc { padding: 20px 22px; }
    .toc ol { columns: 1; }
    .part { margin-top: 36px; }
  }

  .footer { border-top: 1px solid var(--stroke); }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; padding-block: 22px; font-size: 13.5px; color: var(--text-2); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer-links a { display: inline-flex; align-items: center; gap: 6px; color: var(--text-2); font-weight: 500; }
  .footer-links a:hover { color: var(--text); }
</style>
