---
// The page while the apps are not in the stores yet: what Qasa is, with no store links,
// prices to choose or sections to get lost in. The full page is Landing.astro; the
// pages switch back to it at launch (see TODO.md).
import "../styles/global.css";
import Icon from "./Icon.astro";
import { dictionaries, languages, privacyHrefs, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
const t = dictionaries[lang];
const dir = lang === "en" ? "ltr" : "rtl";
const pointIcons = ["device-mobile", "key", "cloud-off"];
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.soon.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f6f4fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17152a" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={t.soon.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={{ en: "en_US", ckb: "ckb_IQ", ar: "ar_IQ" }[lang]} />
    {languages.map((l) => <link rel="alternate" hreflang={l.lang} href={l.href} />)}
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Rubik-Variable.ttf" as="font" type="font/ttf" crossorigin />
    {dir === "rtl" && <link rel="preload" href="/fonts/rudawregular2.ttf" as="font" type="font/ttf" crossorigin />}
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href={languages.find((l) => l.lang === lang)!.href} class="brand" lang="en" aria-label="Qasa">
          <span class="brand-mark"><Icon name="shield-check" filled size={18} /></span>
          Qasa
        </a>
        <nav class="lang-switch" aria-label={t.nav.language}>
          {languages.map((l) => (
            <a href={l.href} lang={l.lang} hreflang={l.lang} aria-current={l.lang === lang ? "page" : undefined}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="eyebrow"><span class="dot"><Icon name="clock" size={13} /></span>{t.soon.eyebrow}</span>
            <h1>{t.hero.h1} <em>{t.hero.h1Accent}</em></h1>
            <p class="lede">{t.hero.lede}</p>

            <div class="soon">
              <span class="soon-badge">{t.soon.badge}</span>
              <span class="soon-stores">
                <Icon name="brand-apple" size={18} />
                <Icon name="brand-google-play" size={17} />
                {t.soon.stores}
              </span>
            </div>
            <p class="pricing">{t.soon.pricing}</p>

            <ul class="hero-points">
              <li><Icon name="circle-check" size={18} /> <span lang="en">English</span> · <span lang="ckb">کوردی</span> · <span lang="ar">العربية</span></li>
              <li><Icon name="circle-check" size={18} /> {t.hero.neverServer}</li>
            </ul>
          </div>

          <div class="hero-art">
            <figure class="device">
              <picture>
                <source srcset={`/screens/passwords-${lang}-dark.webp`} media="(prefers-color-scheme: dark)" />
                <img src={`/screens/passwords-${lang}-light.webp`} alt={t.hero.screenAlt} width="300" height="652" fetchpriority="high" />
              </picture>
            </figure>
          </div>
        </div>
      </section>

      <section class="points" aria-label={t.privacy.kicker}>
        <div class="wrap">
          <ul>
            {t.privacy.points.map((p, i) => (
              <li>
                <span class="point-icon"><Icon name={pointIcons[i]} size={20} /></span>
                <span><b>{p.title}</b><small>{p.body}</small></span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span class="brand small" lang="en"><span class="brand-mark"><Icon name="shield-check" filled size={15} /></span>Qasa</span>
        <a href={privacyHrefs[lang]} class="footer-link">{t.legal.privacyPolicy}</a>
        <p>© {new Date().getFullYear()} <span lang="en">Qasa</span></p>
      </div>
    </footer>
  </body>
</html>

<style>
  body { min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; }

  .nav { border-bottom: 1px solid color-mix(in srgb, var(--stroke) 70%, transparent); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
  /* The logo lockup is artwork: same order and font in every language. */
  .brand { direction: ltr; display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 21px; color: var(--accent); letter-spacing: -0.01em; }
  .brand-mark { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); }
  .brand.small { font-size: 16px; gap: 8px; }
  .brand.small .brand-mark { width: 26px; height: 26px; border-radius: 8px; }

  .lang-switch {
    display: flex; gap: 2px; padding: 3px; border-radius: 12px;
    background: var(--card); border: 1px solid var(--stroke); font-size: 13px; font-weight: 500;
  }
  .lang-switch a { padding: 5px 10px; border-radius: 9px; color: var(--text-2); line-height: 1.4; }
  .lang-switch a:hover { color: var(--text); }
  .lang-switch a[aria-current="page"] { background: var(--card-muted); color: var(--on-accent-chip); }

  /* Kurdish and Arabic: taller script needs looser leading. */
  [dir="rtl"] .hero h1 { line-height: 1.3; letter-spacing: 0; }
  [dir="rtl"] .lede, [dir="rtl"] .pricing { line-height: 1.8; }

  .hero { position: relative; overflow: hidden; padding: clamp(32px, 6vw, 72px) 0 clamp(40px, 6vw, 72px); }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, var(--card-muted) 0%, var(--background) 78%); }
  .hero-inner { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 48px; }
  .hero h1 { margin-top: 22px; font-size: clamp(38px, 5.4vw, 62px); font-weight: 600; line-height: 1.04; letter-spacing: -0.035em; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero .lede { max-width: 520px; font-size: clamp(17px, 1.8vw, 19px); }

  /* In place of the store buttons: plainly not something to tap yet. */
  .soon { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 30px; }
  .soon-badge {
    display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 14px;
    background: var(--accent); color: var(--on-accent); font-weight: 600; font-size: 16px;
  }
  .soon-stores { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 15px; font-weight: 500; }
  .pricing { margin-top: 18px; max-width: 520px; font-size: 14.5px; color: var(--text-2); line-height: 1.6; }

  .hero-points { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14.5px; color: var(--text-2); }
  .hero-points li { display: inline-flex; align-items: center; gap: 7px; }
  .hero-points :global(.icon) { color: var(--success); }

  .hero-art { position: relative; display: grid; place-items: center; }
  .device {
    margin: 0; position: relative; width: 290px; border-radius: 46px; padding: 9px; background: #1c1a2b;
    box-shadow: 0 0 0 1px #2c2944, var(--shadow-soft), 0 50px 100px -40px rgba(76, 61, 184, 0.45);
  }
  .device img { display: block; width: 100%; height: auto; border-radius: 37px; }

  .points { padding: 8px 0 clamp(40px, 6vw, 64px); }
  .points ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .points li {
    display: flex; align-items: flex-start; gap: 12px; padding: 18px; border-radius: var(--radius);
    background: var(--card); border: 1px solid var(--stroke);
  }
  .points b { display: block; font-weight: 600; font-size: 15px; }
  .points small { display: block; margin-top: 2px; color: var(--text-2); font-size: 14px; line-height: 1.5; }
  .point-icon { width: 38px; height: 38px; flex-shrink: 0; border-radius: 12px; display: grid; place-items: center; background: var(--card-muted); color: var(--on-accent-chip); }

  .footer { border-top: 1px solid var(--stroke); }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; padding-block: 22px; font-size: 13.5px; color: var(--text-3); }
  .footer-link { color: var(--text-2); font-weight: 500; }
  .footer-link:hover { color: var(--text); }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy { display: flex; flex-direction: column; align-items: center; }
    .hero .lede, .pricing { margin-inline: auto; }
    .soon, .hero-points { justify-content: center; }
    .hero-art { padding-top: 8px; }
    .points ul { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
  @media (max-width: 560px) {
    .device { width: 250px; }
  }
</style>
