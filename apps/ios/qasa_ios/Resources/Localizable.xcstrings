    "backup.reminder.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up backups"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد النسخ الاحتياطي"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕێکخستنی باکئەپ"
          }
        }
      }
    },
    "backup.reminder.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault is only on this phone. If you lose it or delete Qasa, a backup is the only way to get your passwords back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزنتك موجودة على هذا الهاتف فقط. إذا فقدته أو حذفت قاصة، فالنسخة الاحتياطية هي الطريقة الوحيدة لاستعادة كلمات مرورك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کۆگاکەت تەنها لەسەر ئەم مۆبایلەیە. ئەگەر ونی بکەیت یان قاسە بسڕیتەوە، باکئەپ تاکە ڕێگەیە بۆ گەڕاندنەوەی وشە نهێنییەکانت."
          }
        }
      }
    },
    "backup.reminder.dismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئێستا نا"
          }
        }
      }
    },
    "backup.reminder.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up your vault"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ خزنتك احتياطيًا"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "باکئەپی کۆگاکەت بکە"
          }
        }
      }
    },
    "backup.replace.bodyFmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device restored a backup made on “%1$@”. Unlink “%1$@” and continue here? It will be signed out right away, and your other devices will be told."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعاد هذا الجهاز نسخة احتياطية أُنشئت على «%1$@». هل تريد إلغاء ربط «%1$@» والمتابعة هنا؟ سيُسجَّل خروجه فورًا، وستُبلَّغ أجهزتك الأخرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم ئامێرە باکئەپێکی گەڕاندەوە کە لەسەر «%1$@» دروست کرابوو. «%1$@» لاببەیت و لێرە بەردەوام بیت؟ دەستبەجێ دەردەچێت، و ئامێرەکانی ترت ئاگادار دەکرێنەوە."
          }
        }
      }
    },
    "backup.replace.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlink and continue"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الربط والمتابعة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لابردن و بەردەوامبوون"
          }
        }
      }
    },
    "backup.replace.doneFmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was unlinked. This device has taken its place."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء ربط «%@». أخذ هذا الجهاز مكانه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» لابرا. ئەم ئامێرە جێگەکەی گرتەوە."
          }
        }
      }
    },
    "backup.replace.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't replace the device. Check your connection, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استبدال الجهاز. تحقّق من اتصالك ثم حاول مرة أخرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نەتوانرا ئامێرەکە بگۆڕدرێت. پەیوەندییەکەت بپشکنە، پاشان هەوڵ بدەرەوە."
          }
        }
      }
    },
    "backup.replace.notEnough": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlinking the old device wouldn't free enough room for your plan. Upgrade to Premium, or unlink more devices from another device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء ربط الجهاز القديم لن يُفرغ مساحة كافية لخطتك. رقِّ إلى بريميوم، أو ألغِ ربط أجهزة أخرى من جهاز آخر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لابردنی ئامێرە کۆنەکە شوێنی پێویست بۆ پلانەکەت ناکاتەوە. بڕۆ بۆ پریمیۆم، یان ئامێری زیاتر لە ئامێرێکی ترەوە لاببە."
          }
        }
      }
    },
    "backup.replace.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace your old device?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال جهازك القديم؟"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئامێرە کۆنەکەت بگۆڕیت؟"
          }
        }
      }
    },
    "backup.replace.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup can't free a place for this device. It may be older than that device's latest backup, or that device was unlinked or never went online. Unlink the old device from another device, upgrade to Premium, or contact us."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذه النسخة الاحتياطية أن تُفرغ مكانًا لهذا الجهاز. قد تكون أقدم من آخر نسخة احتياطية لذلك الجهاز، أو أُلغي ربط ذلك الجهاز أو لم يتصل بالإنترنت قط. ألغِ ربط الجهاز القديم من جهاز آخر، أو رقِّ إلى بريميوم، أو تواصل معنا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم باکئەپە ناتوانێت شوێن بۆ ئەم ئامێرە بکاتەوە. لەوانەیە لە دوایین باکئەپی ئەو ئامێرە کۆنتر بێت، یان ئەو ئامێرە لابرابێت یان هەرگیز ئۆنلاین نەبووبێت. ئامێرە کۆنەکە لە ئامێرێکی ترەوە لاببە، بڕۆ بۆ پریمیۆم، یان پەیوەندیمان پێوە بکە."
          }
        }
      }
    },
    "backup.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from a backup"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستعادة من نسخة احتياطية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
