    "totp.cameraDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qasa needs the camera to scan the QR code. Allow it in Settings, or enter the setup key instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج قاصة إلى الكاميرا لمسح رمز QR. اسمح بها من الإعدادات، أو أدخل مفتاح الإعداد بدلًا من ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
