    "settings.changeMasterSubtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your current master password, then choose a new one. All vault items are re-encrypted on this device. Other devices keep working until they unlock with the new password after sync—or re-register if they only have the old verifier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة المرور الرئيسية الحالية ثم اختر واحدةً جديدة. تُعاد تشفير كل عناصر الخزنة على هذا الجهاز."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکی ئێستا بنووسە، پاشان یەکێکی نوێ هەڵبژێرە. هەموو بڕگەکانی کۆگا لەم ئامێرە دووبارە کۆد دەکرێنەوە."
          }
        }
      }
    },
