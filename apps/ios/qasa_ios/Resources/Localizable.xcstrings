    "auth.create.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one password opens all your other passwords. Pick something you'll remember."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور هذه تفتح جميع كلمات مرورك الأخرى. اختر شيئًا ستتذكره."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم یەک وشە نهێنییە هەموو وشە نهێنییەکانی ترت دەکاتەوە. شتێک هەڵبژێرە کە لەبیرت بمێنێت."
          }
        }
      }
    },
    "auth.create.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your main password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة مرورك الرئيسية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکیت هەڵبژێرە"
          }
        }
      }
    },
    "auth.create.weak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضعيفة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لاواز"
          }
        }
      }
    },
    "auth.create.zeroKnowledge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can see your passwords"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت وحدك من يرى كلمات مرورك"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها تۆ دەتوانیت وشە نهێنییەکانت ببینیت"
          }
        }
      }
    },
    "auth.create.zeroKnowledgeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not even Qasa can see them or reset your main password. If you forget it, your saved passwords can't be recovered."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى قاصة لا يمكنها رؤيتها أو إعادة تعيين كلمة مرورك الرئيسية. إذا نسيتها، لا يمكن استعادة كلمات المرور المحفوظة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنانەت قاسە ناتوانێت بیانبینێت یان وشەی نهێنی سەرەکیت ڕێکبخاتەوە. ئەگەر لەبیرت چوو، وشە نهێنییە پاشەکەوتکراوەکانت ناگەڕێنەوە."
          }
        }
      }
    },
    "auth.securingVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting things ready…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التجهيز…"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئامادەکردن…"
          }
        }
      }
    },
    "auth.unlock.biometrics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fingerprint or face"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم البصمة أو الوجه"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پەنجەمۆر یان ڕوخسار بەکاربهێنە"
          }
        }
      }
    },
    "auth.unlock.biometricsFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work. Enter your main password instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح ذلك. أدخل كلمة مرورك الرئيسية بدلًا من ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرکەوتوو نەبوو. لەبری ئەوە وشەی نهێنی سەرەکیت بنووسە."
          }
        }
      }
    },
    "auth.unlock.biometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Qasa without typing your password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح قاصة دون كتابة كلمة المرور"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قاسە بکەرەوە بەبێ نووسینی وشەی نهێنی"
          }
        }
      }
    },
    "auth.unlock.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کردنەوە"
          }
        }
      }
    },
    "auth.unlock.enableBiometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn on fingerprint or face unlock in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تفعيل الفتح بالبصمة أو الوجه من الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەتوانیت کردنەوە بە پەنجەمۆر یان ڕوخسار لە ڕێکخستنەکان چالاک بکەیت."
          }
        }
      }
    },
    "auth.unlock.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private to you"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصة بك وحدك"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها بۆ تۆ"
          }
        }
      }
    },
    "auth.unlock.localOnlyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your passwords stay on this phone. Qasa can't reset your main password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى كلمات مرورك على هذا الهاتف. لا يمكن لقاصة إعادة تعيين كلمة مرورك الرئيسية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشە نهێنییەکانت لەسەر ئەم مۆبایلە دەمێننەوە. قاسە ناتوانێت وشەی نهێنی سەرەکیت ڕێکبخاتەوە."
          }
        }
      }
    },
    "auth.unlock.masterPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الرئيسية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکی"
          }
        }
      }
    },
    "auth.unlock.masterPasswordDueFmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been %lld days, so enter your main password to keep it fresh in your mind. Face or fingerprint unlock works again after this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّ %lld يومًا، لذا أدخل كلمة مرورك الرئيسية حتى تبقى في ذاكرتك. سيعمل الفتح بالوجه أو البصمة مجددًا بعد ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ڕۆژ تێپەڕیوە، بۆیە وشەی نهێنی سەرەکیت بنووسە تاوەکو لەبیرت بمێنێت. دوای ئەوە کردنەوە بە ڕوخسار یان پەنجەمۆر دووبارە کار دەکات."
          }
        }
      }
    },
    "auth.unlock.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter password"
          }
