    "auth.create.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a master password to secure your local vault. This is the only key."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن كلمة مرور رئيسية لتأمين خزنتك المحلية. هذا هو المفتاح الوحيد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەیەکی نهێنی سەرەکی دابنێ بۆ پاراستنی کۆگای ناوخۆیی. ئەمە تەنها کلیلیە."
          }
        }
      }
    },
    "auth.create.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Vault"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء خزنة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دروستکردنی کۆگا"
          }
        }
      }
    },
    "auth.create.weak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak"
