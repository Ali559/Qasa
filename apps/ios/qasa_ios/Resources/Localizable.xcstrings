{
  "sourceLanguage": "en",
  "strings": {
    "auth.create.alreadyHave": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have a vault? Unlock"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل لديك خزنة بالفعل؟ افتح"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێشتر کۆگات هەیە؟ بکەرەوە"
          }
        }
      }
    },
    "auth.create.biometrics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Biometric Unlock"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل الفتح بالبيانات الحيوية"
