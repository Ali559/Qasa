        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الفتح بالبيانات الحيوية. أدخل كلمة المرور الرئيسية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کردنەوەی بایۆمەتریک سەرنەکەوت. وشەی نهێنی سەرەکی بنووسە."
          }
        }
      }
    },
