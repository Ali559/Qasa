    "backup.error.wrongPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That main password doesn't open this backup."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الرئيسية هذه لا تفتح هذه النسخة الاحتياطية."
          }
        },
        "ckb": {
          "stringUnit": {
