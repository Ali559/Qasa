    "premium.autoRenewDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before each period ends, we send you a link to pay for the next one. Nothing is taken until you pay it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل انتهاء كل فترة نرسل لك رابطاً لدفع الفترة التالية. لا يُخصم شيء حتى تدفعه بنفسك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێش کۆتایی هەر ماوەیەک، بەستەرێکت بۆ دەنێرین بۆ پارەدانی ماوەی داهاتوو. هیچ پارەیەک نابڕدرێت تا خۆت نەیدەیت."
          }
        }
      }
    },
    "premium.autoRenewDetailCharge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We charge your wallet the plan price at the end of each period until you turn this off in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نخصم سعر الخطة من محفظتك في نهاية كل فترة حتى توقف ذلك من الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لە کۆتایی هەر ماوەیەکدا نرخی پلانەکە لە جزدانەکەت دەبڕین تا لە ڕێکخستنەکاندا ئەمە بکوژێنیتەوە."
          }
        }
      }
    },
