    "breached.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the breach check. Try again when you're online."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى فحص التسريبات. أعد المحاولة عند الاتصال بالإنترنت."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نەتوانرا پشکنینی دزەکردن بکرێت. کاتێک ئینتەرنێتت هەبوو دووبارە هەوڵ بدەرەوە."
          }
        }
      }
    },
    "breached.privacyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each password is hashed on your phone, and only the first 5 characters of that hash are sent to Have I Been Pwned. Your passwords never leave this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحوَّل كل كلمة مرور إلى بصمة (hash) على هاتفك، ولا يُرسَل إلى Have I Been Pwned سوى أول 5 أحرف منها. لا تغادر كلمات مرورك هذا الجهاز أبدًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر وشەیەکی نهێنی لەسەر مۆبایلەکەت هاش دەکرێت، و تەنها ٥ پیتی یەکەمی ئەو هاشە دەنێردرێت بۆ Have I Been Pwned. وشە نهێنییەکانت هەرگیز ئەم ئامێرە بەجێناهێڵن."
          }
        }
      }
    },
    "breached.privacyTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
