    "settings.autoLockHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this many minutes of inactivity—or when you return from the background past this limit—the vault locks and you’ll need your master password or biometrics."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد هذه الدقائق من عدم النشاط—أو عند العودة من الخلفية بعد تجاوز هذا الحد—تُقفل الخزنة وستحتاج كلمة المرور الرئيسية أو القياسات الحيوية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
