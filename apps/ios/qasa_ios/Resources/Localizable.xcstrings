    "settings.deleteAccountMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your account, linked devices and inbox from Qasa's servers and erases the vault on this phone. Payments are kept as financial records. This can't be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا حسابك والأجهزة المرتبطة وصندوق الوارد من خوادم قاصة، ويمسح الخزنة على هذا الهاتف. تبقى المدفوعات كسجلات مالية. لا يمكن التراجع عن ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە هەژمارەکەت، ئامێرە بەستراوەکان و سندوقی نامەکانت لە ڕاژەکارەکانی قاسە دەسڕێتەوە و گەنجینەی سەر ئەم مۆبایلە دەسڕێتەوە. پارەدانەکان وەک تۆماری دارایی دەمێننەوە. ناگەڕێتەوە."
          }
        }
      }
    },
