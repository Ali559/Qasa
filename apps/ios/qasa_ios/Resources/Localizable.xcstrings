    "breach.upgradeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll send a push alert if a watched email appears in a breach. Upgrade for full scan details."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنرسل تنبيهًا إذا ظهر بريد مراقب في اختراق. رقِّ للترقية لعرض تفاصيل الفحص."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاگادارییەک دەنێرین ئەگەر ئیمەیڵێکی چاودێریکراو لە دزەکردندا دەربکەوێت. بۆ وردەکاری تەواو، پلانی پریمیۆم هەڵبژێرە."
          }
        }
      }
    },
