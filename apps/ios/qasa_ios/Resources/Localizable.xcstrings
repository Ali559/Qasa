    "auth.unlock.biometricsFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work. Enter your main password instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح ذلك. أدخل كلمة مرورك الرئيسية بدلًا من ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرکەوتوو نەبوو. لەبری ئەوە وشەی نهێنی سەرەکیت بنووسە."
          }
        }
      }
    },
    "auth.unlock.biometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Qasa without typing your password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
