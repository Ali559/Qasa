    "sync.differentVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These devices have different vaults, so they can't sync. Only a new device can join an existing vault."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذان الجهازان يحملان خزنتين مختلفتين، لذا لا يمكن مزامنتهما. يمكن لجهاز جديد فقط الانضمام إلى خزنة موجودة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم ئامێرانە گەنجینەی جیاوازیان هەیە، بۆیە ناتوانن هاوکات بن. تەنها ئامێرێکی نوێ دەتوانێت بچێتە ناو گەنجینەیەکی هەبوو."
          }
        }
      }
    },
