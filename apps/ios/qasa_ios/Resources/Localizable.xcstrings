    "backup.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup is one encrypted file with everything in your vault. Qasa doesn't upload it anywhere: you choose where it's saved. Pick a folder in Google Drive or iCloud Drive, so you can get your vault back if you lose the phone or delete Qasa. It opens only with your main password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة الاحتياطية ملف مشفّر واحد يحوي كل ما في خزنتك. لا ترفعه قاصة إلى أي مكان: أنت تختار أين يُحفظ. اختر مجلدًا في Google Drive أو iCloud Drive، لتستعيد خزنتك إذا فقدت الهاتف أو حذفت قاصة. لا يُفتح إلا بكلمة مرورك الرئيسية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پاشەکەوت یەک فایلی کۆدکراوە کە هەموو ناوەڕۆکی گەنجینەکەتی تێدایە. قاسە بۆ هیچ شوێنێک بەرزی ناکاتەوە: خۆت هەڵدەبژێریت لە کوێ پاشەکەوت بکرێت. فۆڵدەرێک لە Google Drive یان iCloud Drive هەڵبژێرە، بۆ ئەوەی ئەگەر مۆبایلەکەت ون کرد یان قاسەت سڕییەوە گەنجینەکەت بگەڕێنیتەوە. تەنها بە وشەی نهێنیی سەرەکیت دەکرێتەوە."
          }
        }
      }
    },
    "backup.lastBackupFmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last backup: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر نسخة احتياطية: %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دوایین باکئەپ: %@"
          }
        }
      }
    },
    "backup.locationHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each new backup replaces this device's previous one, automatic or manual."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل نسخة احتياطية جديدة تحل محل النسخة السابقة من هذا الجهاز، تلقائية كانت أو يدوية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر باکئەپێکی نوێ جێگەی باکئەپی پێشووی ئەم ئامێرە دەگرێتەوە، خۆکار بێت یان دەستی."
          }
        }
      }
    },
    "backup.locationNone": {
      "localizations": {
