    "pair.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have Qasa on another device?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل لديك قاصة بالفعل على جهاز آخر؟"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێشتر قاسەت لەسەر ئامێرێکی تر هەیە؟"
          }
        }
      }
    },
    "pair.invalidCode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid code. Ask the other device to show a fresh pairing code, or paste the account ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز غير صالح. اطلب من الجهاز الآخر إظهار رمز اقتران جديد، أو الصق معرّف الحساب."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کۆد هەڵەیە. داوا بکە ئامێرەکەی تر کۆدێکی نوێ پیشان بدات، یان ناسنامەی هەژمار بلکێنە."
          }
        }
      }
    },
    "pair.limitExceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account already has the maximum number of linked devices. Unlink one on the other device, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب بلغ الحد الأقصى للأجهزة المرتبطة. ألغِ ربط جهاز من الجهاز الآخر ثم أعد المحاولة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم هەژمارە گەیشتووەتە زۆرترین ژمارەی ئامێر. یەکێکیان لە ئامێرەکەی تر لاببەستە، پاشان دووبارە هەوڵبدە."
          }
        }
      }
    },
    "pair.phoneBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your other device, open Settings → Linked Devices → Sync on this network and start hosting. Then pick it below and type the code it shows. Your vault is copied here, still encrypted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهازك الآخر، افتح الإعدادات ← الأجهزة المرتبطة ← المزامنة على هذه الشبكة وابدأ الاستضافة. ثم اختره أدناه واكتب الرمز الظاهر. تُنسخ خزنتك إلى هنا وهي مشفّرة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لەسەر ئامێرەکەی ترت، ڕێکخستنەکان ← ئامێرە بەستراوەکان ← هاوکاتکردن لەسەر ئەم تۆڕە بکەرەوە و میوانداری دەست پێبکە. پاشان لە خوارەوە هەڵیبژێرە و ئەو کۆدەی پیشانی دەدات بنووسە. گەنجینەکەت بە شێوەی شفرەکراو بۆ ئێرە کۆپی دەکرێت."
          }
        }
      }
    },
    "pair.premiumBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to unlock Premium for multi-device linking. Free accounts can keep the vault open on one device only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج إلى فتح الاشتراك المميز لربط أكثر من جهاز. الحسابات المجانية تبقي الخزنة مفتوحة على جهاز واحد فقط."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بۆ بەستنی چەند ئامێرێک دەبێت پریمیۆم بکەیتەوە. هەژماری خۆڕایی تەنها لەسەر یەک ئامێر کۆگا دەکاتەوە."
          }
        }
      }
    },
    "pair.premiumTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium required"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الاشتراك المميز"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پریمیۆم پێویستە"
          }
        }
      }
    },
    "pair.successBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: create a master password on this device. Then unlock or sync the vault over LAN from Settings → Sync on this network."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التالي: أنشئ كلمة مرور رئيسية على هذا الجهاز. ثم افتح الخزنة أو زامنها عبر الشبكة المحلية من الإعدادات ← المزامنة على هذه الشبكة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دواتر: وشەی نهێنی سەرەکی لەم ئامێرە دروست بکە. پاشان کۆگا بکەرەوە یان لە ڕێکخستنەکان ← هاوکاتکردن لەم تۆڕەدا هاوکات بکە."
          }
        }
      }
    },
