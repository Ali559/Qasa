    "auth.unlock.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your main password to see your passwords."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة مرورك الرئيسية لرؤية كلمات مرورك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکیت بنووسە بۆ بینینی وشە نهێنییەکانت."
          }
        }
      }
    },
    "auth.unlock.title": {
      "localizations": {
