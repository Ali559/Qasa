    "pair.adoptBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt an existing account ID and create a local vault on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم معرّف حساب موجود وأنشئ خزنة محلية على هذا الجهاز."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناسنامەی هەژمارێکی هەبوو بەکاربهێنە و کۆگایەکی ناوخۆیی لەسەر ئەم ئامێرە دروست بکە."
          }
        }
      }
    },
    "pair.adoptButton": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt account & create local vault"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتماد الحساب وإنشاء خزنة محلية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەژمارەکە وەربگرە و کۆگای ناوخۆیی دروست بکە"
          }
        }
      }
    },
    "pair.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be on the same Wi-Fi. On your other phone open Settings → Linked Devices → Show pairing code, then enter it here. You will not create a second vault."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون الجهازان على شبكة Wi-Fi نفسها. على الهاتف الآخر افتح الإعدادات ← الأجهزة المرتبطة ← إظهار رمز الاقتران، ثم أدخله هنا. لن تُنشئ خزنة ثانية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەردوو ئامێرەکە دەبێت لەسەر هەمان وای-فای بن. لە مۆبایلەکەی تر ڕێکخستنەکان ← ئامێرە بەستراوەکان ← پیشاندانی کۆدی جووتکردن بکەرەوە، پاشان لێرە بینووسە. کۆگایەکی دووەم دروست ناکەیت."
          }
        }
      }
    },
    "pair.checkFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify this account. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من هذا الحساب. تحقق من الاتصال ثم أعد المحاولة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نەتوانرا ئەم هەژمارە پشتڕاست بکرێتەوە. پەیوەندییەکەت بپشکنە و دووبارە هەوڵبدە."
          }
        }
      }
    },
