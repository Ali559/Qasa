    "auth.unlock.enableBiometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable biometrics when creating your vault."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل البيانات الحيوية عند إنشاء خزنتك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بایۆمەتریک چالاک بکە کاتێک کۆگا دروست دەکەیت."
          }
        }
      }
    },
    "auth.unlock.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local unlock only"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح محلي فقط"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کردنەوەی ناوخۆیی تەنها"
          }
        }
      }
    },
    "auth.unlock.localOnlyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault never leaves this device. Qasa cannot reset or recover your master password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزنتك لا تغادر هذا الجهاز أبدًا. لا يمكن لـ Qasa إعادة تعيين أو استعادة كلمة المرور الرئيسية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کۆگاکەت هەرگیز ئەم ئامێرە جێناهێڵێت. Qasa ناتوانێت وشەی نهێنی سەرەکی بگەڕێنێتەوە."
          }
        }
      }
    },
    "auth.unlock.masterPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master Password"
