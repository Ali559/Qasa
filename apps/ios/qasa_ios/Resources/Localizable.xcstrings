    "error.unauthorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expired. Unlock your vault again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الجلسة. افتح خزنتك مرة أخرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دانیشتن بەسەرچوو. دووبارە کۆگا بکەرەوە."
          }
        }
      }
    },
    "error.vaultCreateTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create vault"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الخزنة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەستپێکردنی کۆگا سەرکەوتوو نەبوو"
          }
        }
      }
    },
    "error.vaultNewerKdf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault was created by a newer version of Qasa (key format %d). Update the app to unlock it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه الخزنة بإصدار أحدث من قاصة (تنسيق المفاتيح %d). حدّث التطبيق لفتحها."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم سندووقە لە وەرزی نووتری قاسە درووست کراوە (فۆرماتی کلیل %d). ئەپ بۆ نوێبکەوە بۆ کردنەوەی."
          }
        }
      }
    },
    "error.vaultStoreBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qasa could not open your encrypted vault, so it has not started. Your data has NOT been deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكّن قاصة من فتح خزنتك المشفّرة، لذلك لم يبدأ التطبيق. لم يتم حذف بياناتك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قاسە نەیتوانی کۆگای کۆدکراوەکەت بکاتەوە، بۆیە دەست پێنەکرد. داتاکەت نەسڕاوە."
          }
        }
      }
    },
    "error.vaultStoreDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفاصيل: %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وردەکاری: %@"
          }
        }
      }
    },
    "error.vaultStoreHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is usually the device running out of storage. Free up space, then force-quit and reopen Qasa. Do not reinstall the app until the vault opens again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادةً يكون هذا بسبب امتلاء مساحة الجهاز. حرّر مساحة، ثم أنهِ التطبيق وافتح قاصة من جديد. لا تعِد تثبيت التطبيق حتى تُفتح الخزنة مجددًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە زۆرجار لەبەرەوەی تەواو بوونی بۆشایییە. بۆشایی ئازاد بکە، پاشان ئەپەکە بەسەرەکەوە ببخە و دووبارە بیکەرەوە. ئەپەکە مەنە سەرناسێنەوە دەت تا کۆگا دووبارە بێتەوە."
          }
        }
      }
    },
