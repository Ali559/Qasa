            "state": "translated",
            "value": "This feature requires a Premium subscription."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الميزة تتطلب اشتراك بريميوم."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم تایبەتمەندییە پێویستی بە بەشداری پرێمیەم هەیە."
          }
        }
      }
    },
