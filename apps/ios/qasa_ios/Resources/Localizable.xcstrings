    "health.howScoringBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score starts at 100 and drops for weak, reused or breached login passwords. Aim for unique, long passwords with mixed character types."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الدرجة من 100 وتنخفض لكلمات المرور الضعيفة أو المعاد استخدامها أو المسرّبة. احرص على كلمات فريدة وطويلة بأنواع أحرف متنوعة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خاڵ لە ١٠٠ دەست پێدەکات و بۆ وشەی نهێنی لاواز، دووبارەکراو یان دزراو دادەبەزێت. وشەی درێژ و جیاواز بەکاربهێنە."
          }
        }
      }
    },
