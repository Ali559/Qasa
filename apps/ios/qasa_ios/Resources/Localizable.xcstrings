    "backup.error.differentVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup is of a different vault. To restore it, clear this device's local data first, then restore during setup."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة الاحتياطية لخزنة مختلفة. لاستعادتها، امسح البيانات المحلية على هذا الجهاز أولًا، ثم استعدها أثناء الإعداد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم باکئەپە هی کۆگایەکی ترە. بۆ گەڕاندنەوەی، سەرەتا داتای ناوخۆیی ئەم ئامێرە بسڕەوە، پاشان لە کاتی ڕێکخستندا بیگەڕێنەوە."
          }
        }
      }
    },
    "backup.error.newerVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of Qasa. Update Qasa, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من قاصة. حدّث قاصة ثم حاول مرة أخرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم باکئەپە بە وەشانێکی نوێتری قاسە دروست کراوە. قاسە نوێ بکەرەوە، پاشان دووبارە هەوڵ بدەرەوە."
          }
        }
      }
    },
    "backup.error.noVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no vault on this device to back up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد خزنة على هذا الجهاز لنسخها احتياطيًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کۆگایەک لەسەر ئەم ئامێرە نییە بۆ باکئەپکردن."
          }
        }
      }
    },
    "backup.error.notABackup": {
      "localizations": {
        "en": {
