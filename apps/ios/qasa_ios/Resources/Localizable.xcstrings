    "auth.create.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one password opens all your other passwords. Pick something you'll remember."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور هذه تفتح جميع كلمات مرورك الأخرى. اختر شيئًا ستتذكره."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم یەک وشە نهێنییە هەموو وشە نهێنییەکانی ترت دەکاتەوە. شتێک هەڵبژێرە کە لەبیرت بمێنێت."
          }
        }
      }
    },
    "auth.create.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your main password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة مرورك الرئيسية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکیت هەڵبژێرە"
          }
        }
      }
    },
    "auth.create.weak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضعيفة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لاواز"
          }
        }
      }
    },
    "auth.create.zeroKnowledge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can see your passwords"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت وحدك من يرى كلمات مرورك"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها تۆ دەتوانیت وشە نهێنییەکانت ببینیت"
          }
        }
      }
    },
    "auth.create.zeroKnowledgeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not even Qasa can see them or reset your main password. If you forget it, your saved passwords can't be recovered."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى قاصة لا يمكنها رؤيتها أو إعادة تعيين كلمة مرورك الرئيسية. إذا نسيتها، لا يمكن استعادة كلمات المرور المحفوظة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنانەت قاسە ناتوانێت بیانبینێت یان وشەی نهێنی سەرەکیت ڕێکبخاتەوە. ئەگەر لەبیرت چوو، وشە نهێنییە پاشەکەوتکراوەکانت ناگەڕێنەوە."
          }
        }
      }
    },
    "auth.securingVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting things ready…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التجهيز…"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئامادەکردن…"
          }
        }
      }
    },
    "auth.unlock.biometrics": {
      "localizations": {
