          "stringUnit": {
            "state": "translated",
            "value": "ضعيفة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لاواز"
          }
        }
      }
    },
    "auth.create.zeroKnowledge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero-Knowledge"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرفة صفرية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زانینی سفر"
          }
        }
      }
    },
    "auth.create.zeroKnowledgeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your master password cannot be recovered by anyone—not even Qasa. If you lose it, your vault data is permanently inaccessible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأي شخص استعادة كلمة المرور الرئيسية—ولا حتى Qasa. إذا فقدتها، تصبح بيانات الخزنة غير قابلة للوصول نهائيًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکیت لەلایەن کەسێکەوە ناگەڕێتەوە—تەنانەت Qasa. ئەگەر لەدەستی بدەیت، داتای کۆگا بۆ هەمیشە لەدەست دەچێت."
          }
        }
      }
    },
    "auth.securingVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Securing vault…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأمين الخزنة…"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پاراستنی کۆگا…"
          }
        }
      }
    },
    "auth.unlock.biometrics": {
      "localizations": {
