    "devices.cannotUnlinkPrimary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The primary device can’t be unlinked while other devices remain. Unlink others first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلغاء ربط الجهاز الأساسي بينما توجد أجهزة أخرى. ألغِ ربط الأجهزة الأخرى أولاً."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناتوانیت ئامێری سەرەکی لاببەستیت کاتێک ئامێری تر ماوە. سەرەتا ئەوانی تر لاببەستە."
          }
        }
      }
    },
    "devices.infoNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlinking a device signs it out immediately. Local vault data on that device is not deleted from here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء ربط جهاز يسجل خروجه فوراً. بيانات الخزنة المحلية على ذلك الجهاز لا تُحذف من هنا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لابردنی بەستنەوە دەستبەجێ ئامێرەکە دەردەکات. داتای ناوخۆیی لەو ئامێرە لێرەوە ناسرێتەوە."
          }
        }
      }
    },
