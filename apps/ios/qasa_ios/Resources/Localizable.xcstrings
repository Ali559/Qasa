        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "چالاککردنی کردنەوەی بایۆمەتریک"
          }
        }
      }
    },
    "auth.create.biometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID or Fingerprint"
          }
        },
        "ar": {
