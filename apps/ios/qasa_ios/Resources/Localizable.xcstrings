          "stringUnit": {
            "state": "translated",
            "value": "پێشتر Qasaم لەسەر ئامێرێکی تر هەیە"
          }
        }
      }
    },
    "auth.create.reenter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enter password"
          }
        },
