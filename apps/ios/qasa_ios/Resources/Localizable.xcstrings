    "sub.removePaymentMethodConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qasa won't renew Premium automatically until you pay again with auto-renew on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يجدد Qasa اشتراك Premium تلقائيًا حتى تدفع مرة أخرى مع تشغيل التجديد التلقائي."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قاسە پرێمیۆم خۆکارانە نوێ ناکاتەوە تا دووبارە بە نوێبوونەوەی خۆکاری چالاک پارە دەدەیت."
          }
        }
      }
    },
    "sub.renewalLinkReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your renewal is ready. Pay %1$@ IQD by %2$@ to keep Premium going; it adds on to the time you have left."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجديدك جاهز. ادفع %1$@ دينار قبل %2$@ ليستمر Premium؛ تُضاف المدة إلى ما تبقّى لديك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نوێکردنەوەکەت ئامادەیە. %1$@ دینار تا %2$@ بدە بۆ بەردەوامبوونی پرێمیۆم؛ دەچێتە سەر ئەو کاتەی ماوەتەوە."
          }
        }
      }
    },
    "sub.renewalNotPaidYet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paid yet. If you've just paid, it can take a minute to show here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُدفع بعد. إذا دفعت للتو، فقد يستغرق ظهوره هنا دقيقة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هێشتا نەدراوە. ئەگەر ئێستا پارەت دا، لەوانەیە خولەکێک بخایەنێت تا لێرە دەربکەوێت."
          }
        }
      }
    },
    "sub.renewalNotSetUp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan won't renew by itself. We'll remind you before it ends so you can pay for the next period."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتجدد هذه الخطة تلقائياً. سنذكّرك قبل انتهائها لتدفع الفترة التالية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم پلانە خۆی نوێ نابێتەوە. پێش کۆتاییهاتنی بیرت دەخەینەوە بۆ ئەوەی ماوەی داهاتوو بدەیت."
          }
        }
      }
    },
    "sub.renewsByLink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few days before %1$@, we'll send you a link to pay %2$@ IQD for the next period."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل %1$@ ببضعة أيام، سنرسل لك رابطاً لدفع %2$@ دينار للفترة التالية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "چەند ڕۆژێک پێش %1$@، بەستەرێکت بۆ دەنێرین بۆ پارەدانی %2$@ دینار بۆ ماوەی داهاتوو."
          }
        }
      }
    },
    "sub.renewsExpires": {
