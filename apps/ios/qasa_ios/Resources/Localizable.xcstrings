    "pair.invalidCode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid code. Ask the other device to show a fresh pairing code, or paste the account ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز غير صالح. اطلب من الجهاز الآخر إظهار رمز اقتران جديد، أو الصق معرّف الحساب."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کۆد هەڵەیە. داوا بکە ئامێرەکەی تر کۆدێکی نوێ پیشان بدات، یان ناسنامەی هەژمار بلکێنە."
          }
        }
      }
    },
    "pair.limitExceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account already has the maximum number of linked devices. Unlink one on the other device, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب بلغ الحد الأقصى للأجهزة المرتبطة. ألغِ ربط جهاز من الجهاز الآخر ثم أعد المحاولة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم هەژمارە گەیشتووەتە زۆرترین ژمارەی ئامێر. یەکێکیان لە ئامێرەکەی تر لاببەستە، پاشان دووبارە هەوڵبدە."
          }
        }
      }
    },
    "pair.premiumBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to unlock Premium for multi-device linking. Free accounts can keep the vault open on one device only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج إلى فتح الاشتراك المميز لربط أكثر من جهاز. الحسابات المجانية تبقي الخزنة مفتوحة على جهاز واحد فقط."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بۆ بەستنی چەند ئامێرێک دەبێت پریمیۆم بکەیتەوە. هەژماری خۆڕایی تەنها لەسەر یەک ئامێر کۆگا دەکاتەوە."
          }
        }
      }
    },
    "pair.premiumTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium required"
          }
