    "breached.lockedBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium checks every saved password against known data breaches and shows which ones to change. Only a 5-character code ever leaves your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص بريميوم كل كلمة مرور محفوظة مقابل التسريبات المعروفة ويُظهر لك ما يجب تغييره. لا يغادر هاتفك سوى رمز من 5 أحرف."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پریمیۆم هەموو وشەیەکی نهێنیی پاشەکەوتکراو لەگەڵ دزەکراوە ناسراوەکان بەراورد دەکات و پیشانت دەدات کامیان بگۆڕیت. تەنها کۆدێکی ٥ پیتی لە مۆبایلەکەت دەردەچێت."
          }
        }
      }
    },
