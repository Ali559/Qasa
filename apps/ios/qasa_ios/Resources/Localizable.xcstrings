    "lan.requiresPremium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device sync requires Premium. Both devices must be on the same Wi‑Fi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الأجهزة تتطلب بريميوم. يجب أن يكون الجهازان على نفس شبكة Wi‑Fi."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هاوکاتکردنی ئامێر پێویستی بە پرێمیەم هەیە. هەردوو ئامێر دەبێت لەسەر هەمان Wi‑Fi بن."
          }
        }
      }
    },
    "lan.secureBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault ciphertext only. Enter the same 6-digit code on both devices. Never use public Wi‑Fi you do not trust."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الخزنة المشفر فقط. أدخل نفس الرمز المكون من 6 أرقام على الجهازين. لا تستخدم Wi‑Fi عامًا غير موثوق."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها داتای نهێنی کۆگا. هەمان کۆدی ٦ ژمارەیی لەسەر هەردوو ئامێر بنووسە. Wi‑Fiی گشتی بەکارمەهێنە."
          }
        }
      }
    },
