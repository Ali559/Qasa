            "state": "translated",
            "value": "استخدم Face ID أو بصمة الإصبع"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID یان پەنجەمۆر بەکاربهێنە"
          }
        }
      }
    },
    "auth.create.button": {
      "localizations": {
