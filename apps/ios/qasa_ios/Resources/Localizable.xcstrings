    "auth.unlock.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کردنەوە"
          }
        }
      }
    },
    "auth.unlock.enableBiometricsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn on fingerprint or face unlock in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تفعيل الفتح بالبصمة أو الوجه من الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەتوانیت کردنەوە بە پەنجەمۆر یان ڕوخسار لە ڕێکخستنەکان چالاک بکەیت."
          }
        }
      }
    },
    "auth.unlock.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private to you"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصة بك وحدك"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها بۆ تۆ"
          }
        }
      }
    },
    "auth.unlock.localOnlyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your passwords stay on this phone. Qasa can't reset your main password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى كلمات مرورك على هذا الهاتف. لا يمكن لقاصة إعادة تعيين كلمة مرورك الرئيسية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشە نهێنییەکانت لەسەر ئەم مۆبایلە دەمێننەوە. قاسە ناتوانێت وشەی نهێنی سەرەکیت ڕێکبخاتەوە."
          }
        }
      }
    },
    "auth.unlock.masterPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الرئيسية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وشەی نهێنی سەرەکی"
          }
        }
      }
    },
    "auth.unlock.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter password"
          }
        },
        "ar": {
          "stringUnit": {
