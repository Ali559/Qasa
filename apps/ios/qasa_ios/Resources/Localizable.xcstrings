    "totp.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a site asks you to set up two-step verification, scan its QR code here. Qasa then shows the 6-digit code to type in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يطلب منك موقع إعداد التحقق بخطوتين، امسح رمز QR الخاص به هنا. ستعرض لك قاصة الرمز المكوّن من 6 أرقام لتكتبه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتێک ماڵپەڕێک داوات لێدەکات پشتڕاستکردنەوەی دوو هەنگاوی ڕێکبخەیت، کۆدی QR ـەکەی لێرە سکان بکە. ئینجا قاسە ئەو کۆدە ٦ ژمارەییەت پیشان دەدات کە دەینووسیت."
          }
        }
      }
    },
