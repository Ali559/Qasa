    "auth.unlock.localOnlyBody" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خزنتك لا تغادر هذا الجهاز أبدًا. لا يمكن لـ Qasa إعادة تعيين أو استعادة كلمة المرور الرئيسية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆگاکەت هەرگیز ئەم ئامێرە جێناهێڵێت. Qasa ناتوانێت وشەی نهێنی سەرەکی بگەڕێنێتەوە."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault never leaves this device. Qasa cannot reset or recover your master password."
          }
        }
      }
    },
