{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-mock",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/dashboard && VITE_QASA_API_URL= bunx vite --port 5179 --strictPort"
      ],
      "port": 5179
    },
    {
      "name": "dashboard-live-e2e",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/dashboard && VITE_QASA_API_URL=http://127.0.0.1:8099 bunx vite --port 5181 --strictPort"
      ],
      "port": 5181
    },
    {
      "name": "design-mockups",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd docs/design && /usr/bin/python3 -m http.server 5180 --bind 127.0.0.1"
      ],
      "port": 5180
    },
    {
      "name": "landing",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/landing && bunx astro dev --port 5182"
      ],
      "port": 5182
    },
    {
      "name": "landing-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/landing && bunx astro preview --port 5186"
      ],
      "port": 5186
    }
  ]
}
