  "type": {
    "$comment": "IBM Plex Sans Arabic for every language. lineHeight is the font's own (hhea ascent+descent = 1.5 x size); Android and CSS set it explicitly so they match iOS. Weights: 400 regular, 500 medium, 600 semibold, 700 bold.",
    "family": "IBM Plex Sans Arabic",
    "lineHeight": 1.5,
    "styles": {
      "largeTitle":     { "size": 34, "weight": 700 },
      "pageTitle":      { "size": 20, "weight": 700 },
      "sheetTitle":     { "size": 17, "weight": 600 },
      "navTitle":       { "size": 17, "weight": 600 },
      "barButton":      { "size": 17, "weight": 400 },
      "dialogTitle":    { "size": 19, "weight": 600 },
      "dialogMessage":  { "size": 15, "weight": 400 },
      "field":          { "size": 16, "weight": 400 },
      "fieldLabel":     { "size": 12, "weight": 600 },
      "groupLabel":     { "size": 12, "weight": 600 },
      "groupValue":     { "size": 16, "weight": 400 },
      "fieldError":     { "size": 11, "weight": 400 },
      "button":         { "size": 16, "weight": 600 },
      "rowTitle":       { "size": 15, "weight": 500 },
      "rowSubtitle":    { "size": 12, "weight": 400 },
      "rowValue":       { "size": 13, "weight": 400 },
      "sectionLabel":   { "size": 12, "weight": 600 },
      "pill":           { "size": 13, "weight": 500 },
      "toast":          { "size": 14, "weight": 600 },
      "tabLabel":       { "size": 10, "weight": 500 },
      "body":           { "size": 15, "weight": 400 },
      "caption":        { "size": 12, "weight": 400 },
      "vaultRowTitle":  { "size": 16, "weight": 600 },
      "vaultRowSubtitle": { "size": 14, "weight": 400 }
    }
  },

  "motion": {
    "$comment": "Seconds. iOS easeOut = cubic-bezier(0, 0, 0.58, 1); easeInOut = (0.42, 0, 0.58, 1). Springs are SwiftUI response/dampingFraction; Android converts them with QasaTokens.springStiffness/springDamping.",
    "press":      { "duration": 0.12, "curve": "easeOut" },
    "standard":   { "duration": 0.22, "curve": "easeOut" },
    "fast":       { "duration": 0.18, "curve": "easeInOut" },
    "fade":       { "duration": 0.2,  "curve": "easeInOut" },
    "gauge":      { "duration": 1.1,  "curve": "easeOut" },
    "toggle":     { "response": 0.25, "damping": 0.8 },
    "toast":      { "response": 0.35, "damping": 0.85 },
    "pressScale": 0.98,
    "confirmIconScale": 1.2,
    "pressedOpacity": 0.85,
    "disabledOpacity": 0.45,
    "rowPressedOpacity": 0.06,
    "toastVisible": 2.5
  },

  "shadow": {
    "toast": { "color": "000000", "opacity": 0.18, "radius": 14, "x": 0, "y": 6 }
  }
}
