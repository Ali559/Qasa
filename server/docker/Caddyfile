# Public entry point. Caddy obtains and renews the TLS certificate for this name and
# proxies to the API on the internal compose network; the API itself publishes no port.
#
# Caddy replaces any X-Forwarded-For sent by the client with the real peer address, so
# the API can trust this hop (QASA_TRUSTED_PROXY_CIDRS = the compose network) without
# letting callers spoof their address.
{$QASA_PUBLIC_HOST:api.qasa.app} {
	encode zstd gzip

	# Prometheus scrapes api:8080/metrics from inside the network; never serve it publicly.
	@metrics path /metrics
	respond @metrics 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy api:8080
}
