# The web server behind the Cloudflare Tunnel. Cloudflare terminates HTTPS and the
# tunnel (cloudflared, /etc/cloudflared/config.yml) brings every request here, to
# 127.0.0.1:80. Nothing listens publicly: the firewall allows only SSH, so the site and
# API cannot be reached by the server's IP address.

{
	# Cloudflare holds the certificates.
	auto_https off
	servers {
		# Only cloudflared, on this machine, connects.
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

http://api.qasa-app.com {
	bind 127.0.0.1
	encode zstd gzip
	import security_headers

	# Prometheus scrapes 127.0.0.1:8080/metrics locally; never serve it through the tunnel.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy 127.0.0.1:8080 {
		# The API takes the first X-Forwarded-For address. Cloudflare sets
		# Cf-Connecting-IP to the real client and overwrites any a client sends, so pass
		# only that; a client-supplied X-Forwarded-For is dropped.
		header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
	}
}

# The landing page (apps/landing), copied here by deploy.sh.
http://qasa-app.com {
	bind 127.0.0.1
	encode zstd gzip
	import security_headers
	header X-Frame-Options DENY

	# Astro fingerprints everything under /_astro, so it can be cached for good.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	root * /var/www/qasa-app.com
	file_server
}

http://www.qasa-app.com {
	bind 127.0.0.1
	redir https://qasa-app.com{uri} permanent
}
