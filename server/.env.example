DATABASE_URL=postgres://qasa:qasa@localhost:5432/qasa
BIND_ADDR=0.0.0.0:8080
QASA_ENV=dev
QASA_ADMIN_JWT_SECRET=dev-admin-secret-change-me
QASA_ADMIN_SEED_EMAIL=admin@qasa.io
QASA_ADMIN_SEED_PASSWORD=admin123
# QASA_LICENSE_PRIVATE_KEY=<base64-ed25519-private-key>

# Restrict /v1/admin/* to Tailscale peers when set (prod recommended):
# QASA_ADMIN_ALLOW_CIDRS=tailscale
# QASA_ADMIN_CORS_ORIGIN=https://admin.qasa.app

# Production (QASA_ENV=prod):
# QASA_ENV=prod
# QASA_ADMIN_JWT_SECRET=<strong-secret>
# QASA_LICENSE_PRIVATE_KEY=<base64-key>
# QASA_ADMIN_ALLOW_CIDRS=tailscale

# Worker (breach scan + expiry / renew-failed device pushes). Outside prod set:
# QASA_WORKER_ENABLE=1

# Device push via Firebase Cloud Messaging (iOS + Android). One service account
# covers both platforms. Apple .p8 key goes in Firebase Console (not here).
# Without these, inbox rows still write and pushes are logged only.
# QASA_FCM_PROJECT_ID=          # optional if present in the service account JSON
# QASA_FCM_SERVICE_ACCOUNT_JSON=/path/to/firebase-service-account.json
# QASA_FCM_SERVICE_ACCOUNT_JSON_INLINE=   # alternative: paste JSON contents

